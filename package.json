{
  "name": "qa-fleet",
  "version": "2.0.0",
  "description": "A reusable, replayable library of Playwright QA flows for coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": "1.4.0"
  },
  "bin": {
    "qa-fleet": "bin/qa-fleet.ts"
  },
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "bun run scripts/build.ts",
    "install:local": "bun run scripts/install.ts",
    "test:install": "bun run scripts/install-smoke.ts",
    "test:e2e": "bun --no-env-file --no-install node_modules/@playwright/test/cli.js test --config playwright.config.ts specs/replay.spec.ts",
    "test:all": "bash scripts/test-all.sh"
  },
  "dependencies": {
    "@playwright/test": "1.63.0"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.0",
    "@biomejs/biome": "2.5.15"
  }
}
